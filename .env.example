# Variables de entorno del cliente (Expo).
# IMPORTANTE: solo las que empiezan con EXPO_PUBLIC_ llegan a la app.
# NO son secretas: quedan dentro del bundle. No pongas tokens/keys aquí.

# URL del backend. Si se omite, la app usa producción:
#   https://restaurante.comandpos.com
# Para desarrollo local, usa la IP LAN de tu máquina (NO localhost en un
# dispositivo físico). Ejemplo:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# DSN de Sentry (opcional)
# EXPO_PUBLIC_SENTRY_DSN=
